{
	"version": 2,
	"configurePresets": [
		{
			"name": "windows",
			"displayName": "Windows (clang-cl)",
			"description": "Run from a vcvars64 environment with LLVM on PATH, pass Qt with CMAKE_PREFIX_PATH",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl",
				"CMAKE_LINKER": "lld-link",
				"CMAKE_POLICY_VERSION_MINIMUM": "3.5"
			}
		},
		{
			"name": "windows-lint",
			"inherits": "windows",
			"displayName": "Windows lint (clang-cl)",
			"description": "Build for scripts/lint-windows.ps1",
			"binaryDir": "${sourceDir}/build/lint",
			"cacheVariables": {
				"NO_PCH": "ON",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}
	]
}
